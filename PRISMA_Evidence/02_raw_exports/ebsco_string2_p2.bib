 journal   = "Journal of Business Research",
 keywords  = "Human capital; Business networks; Innovation adoption; Strategic alliances (Business); Joint ventures; Corporate culture; Business planning; Business logistics; Process, Physical Distribution, and Logistics Consulting Services; Diffusion of innovations theory",
 pages     = "265-275",
