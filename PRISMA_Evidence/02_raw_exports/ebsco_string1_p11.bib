@article{10014478620141201,
 abstract  = "We find that the likelihood of a female CEO appointment increases with the proportion of female directors on the board. However, this positive relation is significant only in the subsample of firms where one of the directors is appointed CEO, and is insignificant in firms where the new CEO is not from the board. The results are consistent with the explanation that female directors constitute a supply of viable candidates for the CEO position, rather than female directors affecting the likelihood of female CEO appointments by interpreting noisy signals about the abilities of female candidates.",
 author    = "Gupta, Atul and Raman, Kartik",
 number    = "4",
