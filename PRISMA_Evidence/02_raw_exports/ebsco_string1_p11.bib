 year      = "2015",
 issn      = "0167-4544",
 journal   = "Journal of Business Ethics",
 keywords  = "Boards of directors; Women directors of corporations; Shareholder activism; Organizational legitimacy; Organizational change; Social networks; Corporate governance; Other Individual and Family Services; Reliability (Personality trait); Trust",
 pages     = "149-165",
 note      = "",
